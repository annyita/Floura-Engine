vec3 closestPointOnTriangle(vec3 P, vec3 A, vec3 B, vec3 C){
    /** The code for Triangle-float3 test is from Christer Ericson's Real-Time Collision Detection, pp. 141-142. */
    
    // Check if P is in vertex region outside A.
    vec3 ab = B - A;
    vec3 ac = C- A;
    vec3 ap = P - A;
    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.f && d2 <= 0.f)
    return A; // Barycentric coordinates are (1,0,0).
    
    // Check if P is in vertex region outside B.
    vec3 bp = P - B;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.f && d4 <= d3)
    return B; // Barycentric coordinates are (0,1,0).
    
    // Check if P is in edge region of AB, and if so, return the projection of P onto AB.
    float vc = d1*d4 - d3*d2;
    if (vc <= 0.f && d1 >= 0.f && d3 <= 0.f){
        float v = d1 / (d1 - d3);
        return A + v * ab; // The barycentric coordinates are (1-v, v, 0).
    }
    
    // Check if P is in vertex region outside C.
    vec3 cp = P - C;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.f && d5 <= d6)
    return C; // The barycentric coordinates are (0,0,1).
    
    // Check if P is in edge region of AC, and if so, return the projection of P onto AC.
    float vb = d5*d2 - d1*d6;
    if (vb <= 0.f && d2 >= 0.f && d6 <= 0.f){
        float w = d2 / (d2 - d6);
        return A + w * ac; // The barycentric coordinates are (1-w, 0, w).
    }
    
    // Check if P is in edge region of BC, and if so, return the projection of P onto BC.
    float va = d3*d6 - d5*d4;
    if (va <= 0.f && d4 - d3 >= 0.f && d5 - d6 >= 0.f){
        float w = (d4 - d3) / (d4 - d3 + d5 - d6);
        return B + w * (C - B); // The barycentric coordinates are (0, 1-w, w).
    }
    
    // P must be inside the face region. Compute the closest point through its barycentric coordinates (u,v,w).
    float denom = 1.f / (va + vb + vc);
    float v = vb * denom;
    float w = vc * denom;
    return A + ab * v + ac * w;
}

vec4 distanceToClosestPointOnMDFUVprim(vec3 P, float nThickness){
    float minDist = INF;

    int closestPrimIndex = -1;

    for (int i = 0; i < triangles.length(); i++ ){
        triangle tri = triangles[i];
        
        vec3 np = nearestPointOnAABB(P,tri.primPos.xyz, tri.primExt.xyz);
        float nd = distance(np, P);
        if (nd < minDist){
            vec3 tnp = closestPointOnTriangle(P, tri.a.xyz, tri.b.xyz, tri.c.xyz);
            float tnd = distance(tnp, P);
            if (tnd < minDist){
                closestPrimIndex = i;
                minDist = tnd;
            }
        }
    }

    if (closestPrimIndex < 0) return vec4(0.0f);
    triangle tri = triangles[closestPrimIndex];

    vec3 cP = closestPointOnTriangle(P, tri.a.xyz, tri.b.xyz, tri.c.xyz);
    minDist = distance(cP, P);
    
    // if directions are opossing, then flip ld (calc face normal here to cut down on calcs)
    if (dot(P - cP, faceNormalFromTriangle(tri.a.xyz, tri.b.xyz, tri.c.xyz)) < 0.0f && minDist < nThickness)
    minDist = -minDist;

    // calc uv with return instead of every cycle to cut down on calcs
    return vec4(minDist, uvPosFromVertexAndPoint(tri.a.xyz, tri.b.xyz, tri.c.xyz, tri.uvAB.xy, tri.uvAB.zw, tri.uvC.xy, cP), 1.0);
}

vec4 distanceToClosestPointOnMDFUVprimAABBless(vec3 P, float nThickness){
    float minDist = INF;

    int closestPrimIndex = -1;

    for (int i = 0; i < triangles.length(); i++ ){
        triangle tri = triangles[i];
        
        vec3 tnp = closestPointOnTriangle(P, tri.a.xyz, tri.b.xyz, tri.c.xyz);
        float tnd = distance(tnp, P);
        if (tnd < minDist){
            closestPrimIndex = i;
            minDist = tnd;
        }
    }

    if (closestPrimIndex < 0) return vec4(0.0f);
    triangle tri = triangles[closestPrimIndex];

    vec3 cP = closestPointOnTriangle(P, tri.a.xyz, tri.b.xyz, tri.c.xyz);
    minDist = distance(cP, P);

    // if directions are opossing, then flip ld (calc face normal here to cut down on calcs)
    if (dot(P - cP, faceNormalFromTriangle(tri.a.xyz, tri.b.xyz, tri.c.xyz)) < 0.0f && minDist < nThickness)
    minDist = -minDist;

    // calc uv with return instead of every cycle to cut down on calcs
    return vec4(minDist, uvPosFromVertexAndPoint(tri.a.xyz, tri.b.xyz, tri.c.xyz, tri.uvAB.xy, tri.uvAB.zw, tri.uvC.xy, cP), 1.0);
}

void main() { // needs to take uv scale
    const ivec3 uvw = ivec3(gl_GlobalInvocationID.xyz);

    if (uvw.x >= volumeSize.x ||
        uvw.y >= volumeSize.y ||
        uvw.z >= volumeSize.z) return;

    vec3 nMin = ivPosition - ivScale;
    vec3 boundssize = 2.0 * ivScale;
    
    vec3 normalizedUVW = (vec3(uvw) + vec3(0.5f)) / vec3(volumeSize);

    vec3 wp = nMin + normalizedUVW * boundssize;

    //vec4 dist = distanceToClosestPointOnMDFUVprimAABBless(wp, thickness); // 0.05 // 0.001
    vec4 dist = distanceToClosestPointOnMDFUVprim(wp, thickness); // 0.05 // 0.001
    vec2 nUV = dist.yz;
    vec4 albedo = texture(AlbedoHandle, nUV);
    vec4 EM = texture(EMHandle, nUV);
    //EM.rgb = vec3(1.0);

    vec4 final = vec4(dist.x, EM.rgb);
    
    if (accumulateMode){
        vec4 pMDF =imageLoad(outMDF, uvw);
        
        float d = min(pMDF.x, dist.x);
        
        if (pMDF.x == d){
            final = pMDF;
            EM = imageLoad(outALB, uvw);
        }
    }
    //vec4 final
    //dist
    imageStore(outMDF, uvw, final);
    imageStore(outALB, uvw, albedo);
}