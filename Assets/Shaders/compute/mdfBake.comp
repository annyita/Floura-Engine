#version 460 core

#extension GL_ARB_gpu_shader_int64 : enable
#extension GL_ARB_bindless_texture : require

#define INF 3.40282347e+38f

layout(local_size_x = 8, local_size_y = 8, local_size_z =8) in;
//layout(rgba32f, binding = 0) uniform image3D outMDF;
layout(rgba16f, binding = 0) uniform image3D outMDF;
//layout(r8_snorm, binding = 0) uniform image3D outMDF;
layout(rgba8, binding = 1) uniform image3D outALB;

struct triangle{
    vec4 a;
    vec4 b;
    vec4 c;

    vec4 uvAB;
    vec4 uvC;
    
    vec4 primPos;
    vec4 primExt;
};

layout(std430, binding = 15) buffer mesh {
    triangle triangles[];
};

uniform ivec3 volumeSize;

//vec3 ivPosition = vec3(0.0);
//vec3 ivScale = vec3(1.0);
uniform vec3 ivPosition;
uniform vec3 ivScale;
uniform float thickness;
uniform bool accumulateMode;

uniform sampler2D AlbedoHandle;
uniform sampler2D EMHandle;

vec3 faceNormalFromTriangle(vec3 a, vec3 b, vec3 c){
    return normalize(cross(b - a, c - a));
}

vec3 nearestPointOnAABB(vec3 p, vec3 pos, vec3 extents){
    return clamp(p, pos - extents, pos + extents);
}


float AreaOfTriangle(vec3 p1, vec3 p2, vec3 p3){
    // 2 vectors from points
    vec3 u = p2 - p1;
    vec3 v = p3 - p1;
    
    // cross product of u and v
    vec3 cp = cross(u, v);
    
    // half of magnitude of the vector cp
    return length(cp) * 0.5f;
}

vec2 uvPosFromVertexAndPoint(vec3 a, vec3 b, vec3 c, const vec2 aUV, vec2 bUV, vec2 cUV, vec3 p){
    // calc areas
    float totalArea = AreaOfTriangle(a, b, c);
    float areaPAB = AreaOfTriangle(p, a, b);
    float areaPBC = AreaOfTriangle(p, b, c);
    float areaPCA = AreaOfTriangle(p, c, a);
    
    // sum of each area
    float areasum = areaPAB + areaPBC + areaPCA;
    float elipson = 0.0001f * totalArea;
    
    // if point inside elipson
    if (abs(totalArea - areasum) < elipson){
        // calc weight
        float weightA = areaPBC / totalArea;
        float weightB = areaPCA / totalArea;
        float weightC = areaPAB / totalArea;
        
        return vec2( (weightA * aUV) + (weightB * bUV) + (weightC * cUV) );
    }
    return vec2(0.0f);
}

