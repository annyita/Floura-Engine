    nIC.idirectSpecular.rgb = nIC.specular; // nIC.specular null
    nIC.emissionSpecular.rgb = null;

    // temporal accumulation here
    highp vec2 velocity = texelFetch(gVelocity, pixelCoords, 0).rg;

    bool split = true;
    if (pixelCoords.x > screenSize.x / 2 && doDenoiseSplitDBGView) split = false;

    if (doTemporalAccumulation && split && false){ // force off
        float d = linearizeDepth(texelFetch(depthMap, pixelCoords, 0).r, NearPlane, FarPlane);
        highp vec2 historyTexCoord = pixelCoords - velocity;

        indirectChannels nNIC =  temporalAccumulate(nIC, historyTexCoord, d, garm.g);

        imageStore(oindirect, pixelCoords, nNIC.indirect);
        imageStore(oemission, pixelCoords, nNIC.emission);
        imageStore(oindirectSpecular, pixelCoords, nNIC.idirectSpecular);
