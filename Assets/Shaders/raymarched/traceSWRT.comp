    if (!discardThresholdFloat(noise, r_noiseThreshold) ) nIC.specular = reflection(garm, gnrm, origin, reflect(normalize(gp - cameraPosition),  gnrm), r_maxdist, mindist, r_steps, r_bounces, r_samples, r_doSSR,pixelCoords);

    nIC.specular = clamp(nIC.specular, 0.0, 1.0);

