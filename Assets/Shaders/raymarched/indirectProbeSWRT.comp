    //float rmShadow = 0.0f;
    float ssShadow = 0.0f;
    if (doDirShadowMap) shadow = CalcShadowFactorDIR(fragPosLight, lightDirection, normal, iPosition);

    return ((diffuse * (1.0f - shadow) + directAmbient)) * vec4(directLightCol, 1.0f);
}

vec4 spotLight(int iteration, vec3 ARM, vec3 iNormal, vec3 iPosition){
    // controls how big the area that is lit up is
    float outerCone = 0.90f;
    float innerCone = 0.95f;

    // ambient lighting
    //float ambient = 0.0f;

    vec4 finalColour = vec4(0.0f);

    // diffuse lighting
    vec3 normal = normalize(iNormal);

    vec3 lightDirection = normalize(Lights[iteration].position - iPosition);
    float diffuse = max(dot(normal, lightDirection), 0.0f);

    // calculates the intensity of the crntPos based on its angle to the center of the light cone
    float angle = dot(Lights[iteration].rotation, -lightDirection); // direction
    float inten = clamp( (angle - outerCone) / (innerCone - outerCone), 0.0f, 1.0);

    float shadow = 0.0;
    finalColour = finalColour + ((diffuse * (1.0f - shadow) * inten + 0.0f) * vec4(Lights[iteration].colour, 1.0) * inten);

    //finalColour = finalColour + (diffuse * inten + skyColor);

    return finalColour;
}

vec4 pointLight(int iteration, vec3 ARM, vec3 iNormal, vec3 iPosition){
    vec4 finalColour = vec4(0.0f);

    //vec3 lightVec = (Lights[iteration].position) - crntPos;
    vec3 lightVec = (Lights[iteration].position) - iPosition;

    // intensity of light with respect to distance
    float dist = length(lightVec);
    float a = 3.00f;
    float b = 0.70f;
    float inten = 1.0f / (a * dist * dist + b * dist + 1.0) * Lights[iteration].radius;

    // ambient lighting
    //float ambient = 0.0f;
    vec3 normal = normalize(iNormal);
    //vec3 normal = normalize(Normal); 

    vec3 lightDirection = normalize(lightVec);
    float diffuse = max(dot(normal, lightDirection), 0.0f);

    //float ssShadow = shadowTrace(lightDirection, normal, iPosition);

    float shadow = 0.0;

    finalColour = finalColour + ( (diffuse * (1.0f - shadow) * inten + 0.0f) * vec4(Lights[iteration].colour, 1.0) * inten);

    return finalColour;
}

vec4 lights(vec3 ARM, vec3 iNormal, vec3 iPosition){
    vec4 colour = vec4(0.0);

    int maxLights = 64;
    for (int i = 0; i < min(lightCount, maxLights); i++){
        if (Lights[i].type == 0)
        colour += spotLight(i, ARM, iNormal, iPosition);
        if (Lights[i].type == 1)
        colour += pointLight(i, ARM, iNormal, iPosition);
    }

    if (doDirLight)
    colour+= direcLight(ARM, iNormal, iPosition);

    return colour;
}



vec3 fibonacciSphere(float i, float n){
    const float PHI = 1.61803398875;
    float y = 1.0 - (i / (n -1.0)) * 2.0f;
    float radius = sqrt(max(0.0, 1.0 - y * y));
    float theta = 2.0* 3.14159265 * i / PHI;
    
    float x = cos(theta) * radius;
    float z = sin(theta) * radius;
    
    return vec3(x,y,z);
}

vec3 fibonacciSphereJitter(int i, int n, vec3 inp){
    const float PHI = 1.61803398875;
    const float PI = 3.14159265359;
    
    float u1 = hash13(inp + vec3(i * 1.31, 1 * 7.12, 0.0));
    float u2 = hash13(inp + vec3(i * 3.71, 1 * 2.41, 0.0));
    
    float stepY = 2.0 / float(n);
    float y = 1.0 - (float(i) + u1) * stepY;
    float radius = sqrt(max(0.0, 1.0 - y * y));
    float theta = 2.0* PI * (float(i) / PHI + u2); 
    
    return vec3(cos(theta) * radius, y, sin(theta) * radius);
}

void indirectMarch(vec3 dir, vec3 ro, float mindist, out vec3 ind, out vec3 em, out bool isHit){
    hitresult hr = raymarchGDFscene(ro, dir, i_maxdist, mindist, i_steps);
    //isHit = false;
    
    if (!hr.isHit){
        ind = textureLod(cmMainHandle, dir, 0).rgb;
        em = vec3(0.0f);
        return;
    }
    vec3 albedo = textureLod(sampler3D(GDFS[hr.cascade].handle2), hr.uvw, 0).rgb;
    vec3 mEmission = textureLod(sampler3D(GDFS[hr.cascade].handle3), hr.uvw, 0).rgb;
    vec2 rm = textureLod(sampler3D(GDFS[hr.cascade].handle4), hr.uvw, 0).rg;
    vec3 vxIND = textureLod(sampler3D(GDFS[hr.cascade].handle5), hr.uvw, 0).rgb;
    vec3 vxEM = textureLod(sampler3D(GDFS[hr.cascade].handle6), hr.uvw, 0).rgb;
    
    vec3 direct = lights(vec3(1.0, rm), hr.normal, hr.hitpos).rgb;
    direct += directAmbient;
    direct = clamp(direct, 0.0, 1.0);

    // cosine angle of the incoming ray
    //float cosTheta = max(dot(hr.normal, dir), 0.0);
    float cosTheta = max(dot(hr.normal, -dir), 0.0);
    
    //ind = albedo * (direct + vxIND + vxEM); //(accumulation takes care of this so dont do it twice)
    ind = (albedo * direct) * cosTheta * 2.0;
    em = mEmission;

    isHit = true;
}


vec3 sampleHemisphere(vec3 normal, float value, vec2 uv){
    float u = rand(uv + rand(vec2(time, value) ) );
    float v = rand(vec2(u, rand( vec2(time, value) ) ) );

    float phi = 2.0 * 3.14159265 * u;
    float cosTheta = sqrt(1.0 - v);
    float sinTheta = sqrt(v);

    vec3 localDir = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    vec3 helper = abs(normal.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);

    return tangent * localDir.x + bitangent * localDir.y + normal * localDir.z;
}

void main() {
    //return;
    const ivec3 uvw = ivec3(gl_GlobalInvocationID.xyz);

    if (uvw.x >= volumeSize.x ||
        uvw.y >= volumeSize.y ||
        uvw.z >= volumeSize.z) return;

    vec3 normalizedUVW = (vec3(uvw) + vec3(0.5f)) / vec3(volumeSize);
    //vec3 normalizedUVW = (vec3(uvw) ) / vec3(volumeSize);
    vec3 localPos = normalizedUVW - vec3(0.5f);
    vec3 wp = positionScale.xyz + (localPos * vec3(positionScale.w * 2.0));
    
    vec3 indirectLighting = vec3(0.0f);
    vec3 emissionLighting = vec3(0.0f);

    float nThickness = 0.0; int intd = 0;
    float dist = gdfScene(wp, nThickness, intd).r;


    float blendrate = 0.95;
    
    if (dist < 0.001) {
        vec3 priorIndirectData = imageLoad(outIndirect, uvw).rgb;
        vec3 priorEmissionData = imageLoad(outEmission, uvw).rgb;
        
        vec3 accumulatedIndirectData = mix(vec3(0.0), priorIndirectData, 0.98);
        vec3 accumulatedEmissionData = mix(vec3(0.0), priorEmissionData, 0.98);

        imageStore(outIndirect, uvw, vec4(accumulatedIndirectData, 1.0));
        imageStore(outEmission, uvw, vec4(accumulatedEmissionData, 1.0));
        
        return;
    }
    
    int emHit = 0;
    // + frame
    for (int i = 0; i < fibonacciSphereSamples; i++){
        //vec3 dir = sampleSphere(uvw.xy + uvw.z, time);
        vec3 dir = fibonacciSphereJitter(i, fibonacciSphereSamples, hash33(uvw + vec3(fract(time) * 100.0 + float(i))));
        //vec3 dir = fibonacciSphereJitter(float(i), fibonacciSphereSamples, frame);
        //vec3 dir = fibonacciSphere(float(i), fibonacciSphereSamples);

        vec3 em = vec3(0.0); vec3 ind = vec3(0.0); bool isHit = false;
        indirectMarch(dir, wp, mindist, ind, em, isHit);

        indirectLighting += ind;
        if (isHit){ emissionLighting += em; emHit++; }
        //isHit
    }
    vec3 ind = vec3(indirectLighting / max(fibonacciSphereSamples, 1));
    vec3 em = vec3(emissionLighting / max(emHit, 1)); // neds e boost
    
    vec3 priorIndirectData = imageLoad(outIndirect, uvw).rgb;
    vec3 priorEmissionData = imageLoad(outEmission, uvw).rgb;
    
    vec3 accumulatedIndirectData = mix(ind, priorIndirectData, blendrate);
    vec3 accumulatedEmissionData = mix(em, priorEmissionData, blendrate);
    
    imageStore(outIndirect, uvw, vec4(accumulatedIndirectData, 1.0));
    imageStore(outEmission, uvw, vec4(accumulatedEmissionData, 1.0));
}